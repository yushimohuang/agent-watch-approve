# Gateway 包级别 .env.example（与仓库根目录 .env.example 保持一致）
# 详见仓库根目录 .env.example 的注释

PORT=3000
NODE_ENV=development
CORS_ORIGINS=*

# 数据持久化（JSON 文件）
DATA_DIR=

# 信任反向代理（nginx / Cloudflare）
TRUST_PROXY=1

# JWT（生产环境 >=32 字符）
JWT_SECRET=dev-only-do-not-use-in-prod-secret-key-32chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# 飞书
FEISHU_ENABLED=true
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
FEISHU_USER_OPEN_ID_MAP={}

PUBLIC_URL=http://localhost:3000
LOCAL_USER_NAME=local-user
ACCESS_PASSWORD=

# Dashboard 静态托管
DASHBOARD_ENABLED=true

RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
APPROVAL_TIMEOUT=300
