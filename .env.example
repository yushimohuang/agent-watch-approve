# ===========================
# Server
# ===========================
PORT=3000
NODE_ENV=development

# ===========================
# CORS
# ===========================
CORS_ORIGINS=*

# ===========================
# 数据持久化（JSON 文件）
# ===========================
# gateway-state.json 的存放目录。留空 = 写到 packages/gateway/gateway-state.json
# Docker 部署时建议设为 /app/data，并挂载 volume
DATA_DIR=

# ===========================
# 信任反向代理（nginx / Cloudflare / 飞书回调）
# ===========================
# 0 = 不信任（直连），1 = 信任一层代理，'loopback' = 仅本机
# 公网部署必须设为 1，否则 rate-limit 拿到的全是代理 IP
TRUST_PROXY=1

# ===========================
# JWT
# ===========================
# 生产环境必须 >=32 字符且不含 example/test/placeholder 等关键词
# 建议: openssl rand -hex 32
JWT_SECRET=dev-only-do-not-use-in-prod-secret-key-32chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ===========================
# 飞书 (Feishu / Lark) - 唯一推送通道
# ===========================
# 申请地址：https://open.feishu.cn/
# 步骤：
#   1. 注册飞书开放平台 → 创建自建应用 → 启用机器人 + 事件订阅
#   2. 拿 App ID / App Secret / Verification Token / Encrypt Key
#   3. 配 Cloudflare Tunnel 暴露 webhook（见下方 PUBLIC_URL）
#   4. 在飞书开放平台配置事件订阅 URL: {PUBLIC_URL}/webhook/feishu
FEISHU_ENABLED=true
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=your_verification_token
FEISHU_ENCRYPT_KEY=your_encrypt_key
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis

# 飞书用户 open_id 映射（可选 - 用于绑定 userId → 飞书 open_id）
# 格式：{"user_abc123": "ou_xxxxxxxxxxxx"}
# 你可以登录飞书 Open API 自己查 open_id，或让用户扫机器人二维码获取
FEISHU_USER_OPEN_ID_MAP={}

# 公网 URL（飞书 webhook 回调用）
# 方式1: Cloudflare Tunnel（推荐，免费）
#   cloudflared tunnel --url http://localhost:3000
# 方式2: ngrok
#   ngrok http 3000
# 拿到地址后填入：
PUBLIC_URL=http://localhost:3000

# ===========================
# 本地用户名（首次启动时使用，默认 'local-user'）
# ===========================
LOCAL_USER_NAME=local-user

# ===========================
# 公网访问密码（公网暴露时必填）
# ===========================
# 当 PUBLIC_URL 不是 localhost 时，必须设置此密码才能访问 Gateway
# 留空 = 拒绝公网访问（503）
# 建议: openssl rand -hex 16
ACCESS_PASSWORD=

# ===========================
# Dashboard（管理后台）
# ===========================
# true = Gateway 启动时托管 packages/dashboard 的静态产物到 /dashboard
# false = 不托管（仅 API + WebSocket）
DASHBOARD_ENABLED=true

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ===========================
# Approval
# ===========================
APPROVAL_TIMEOUT=300
